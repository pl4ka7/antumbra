    <string name="settings_wallets">Wallets</string>
    <string name="wallets_howto">In your wallet, look for Proxy, SOCKS5 or Tor in the network settings and enter %1$s. Electrum, Monerujo and Green support this.</string>
    <string name="wallets_isolation">If the wallet accepts a SOCKS username and password, use different ones per app: Tor then keeps them on separate circuits.</string>
