<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Antumbra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Theme.Antumbra.Starting" parent="Theme.SplashScreen">
